       1   00:0000                      ; romloader.asm - starts a plain ROM (8, 16 or 32 KB) from a disk made by Nowind Companion, see RomDisk.kt
       2   00:0000                      ;
       3   00:0000                      ; The disk has no MSX-DOS, so Disk BASIC starts and runs AUTOEXEC.BAS:
       4   00:0000                      ;   10 CLEAR 200,&HC400:BLOAD"LOADER.BIN",R
       5   00:0000                      ; GAME.ROM is a 32 KB image of pages 1 and 2 ($4000-$BFFF); the app already placed and mirrored the ROM in it.
       6   00:0000                      ; The loader copies it to the RAM of pages 1 and 2 and calls the INIT address of the ROM header,
       7   00:0000                      ; the way the BIOS starts a cartridge.
       8   00:0000                      ;
       9   00:0000                      ; assemble with nowindlibraries/Release/sjasm.exe, see make.bat
      10   00:0000                      
      11   00:0000  (00:0024)           ENASLT      equ $0024
      12   00:0000  (00:00A2)           CHPUT       equ $00A2
      13   00:0000  (00:F37D)           BDOS        equ $F37D               ; Disk BASIC entry for the BDOS functions
      14   00:0000  (00:F342)           RAMAD1      equ $F342               ; slot of the RAM in page 1, set by the disk ROM
      15   00:0000  (00:FCC1)           EXPTBL      equ $FCC1               ; slot of the main ROM
      16   00:0000                      
      17   00:0000  (00:000F)           F_OPEN      equ $0F
      18   00:0000  (00:001A)           F_SETDMA    equ $1A
      19   00:0000  (00:0027)           F_RANDREAD  equ $27                 ; random block read
      20   00:0000                      
      21   00:0000  (00:8000)           BUFFER      equ $8000               ; page 2 is RAM in BASIC
      22   00:0000                      
      23   00:0000                              output "romloader.bin"
