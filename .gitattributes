# Set the default behavior, in case people don't have core.autocrlf set.
* text eol=lf

# Windows batch files need CRLF
*.bat text eol=crlf

# binary files: never convert line endings, that would corrupt them
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.zip binary
*.7z binary
*.gz binary
*.jar binary
*.aar binary
*.apk binary
*.aab binary
*.so binary
*.jks binary
*.keystore binary
*.dsk binary
*.rom binary
*.wav binary
*.mp3 binary
