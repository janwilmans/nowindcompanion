# Set the default behavior, in case people don't have core.autocrlf set.
# Every file type in the repository is also listed below, so nothing depends on this fallback.
* text eol=lf

# source code
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.py text eol=lf
*.php text eol=lf
*.sh text eol=lf
*.pro text eol=lf
*.asm text eol=lf
gradlew text eol=lf

# configuration and data
*.xml text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.html text eol=lf
*.url text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# documentation
*.md text eol=lf
*.txt text eol=lf
LICENSE text eol=lf

# Windows batch files need CRLF
*.bat text eol=crlf

# binary files: never convert line endings, that would corrupt them
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.zip binary
*.7z binary
*.gz binary
*.jar binary
*.aar binary
*.apk binary
*.aab binary
*.so binary
*.pyc binary
*.jks binary
*.keystore binary
*.dsk binary
*.rom binary
*.bin binary
*.wav binary
*.mp3 binary
